generator client {
  provider            = "prisma-client"
  output              = "../../backend/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum RolUsuario {
  ADMIN
  CONSULTA

  @@map("rol_usuario")
}

enum EstadoHeroe {
  ACTIVO
  INACTIVO

  @@map("estado_heroe")
}

enum NivelPeligro {
  BAJO
  MEDIO
  ALTO

  @@map("nivel_peligro")
}

enum EstadoMision {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA

  @@map("estado_mision")
}

model Usuario {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre          String           @db.VarChar(100)
  email           String           @unique(map: "usuarios_email_key") @db.VarChar(254)
  passwordHash    String           @map("password_hash") @db.VarChar(255)
  rol             RolUsuario       @default(CONSULTA)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  tokensRevocados TokenRevocado[]

  @@map("usuarios")
}

model Heroe {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre         String       @unique(map: "heroes_nombre_key") @db.VarChar(100)
  nombreReal     String       @map("nombre_real") @db.VarChar(120)
  poderPrincipal String       @map("poder_principal") @db.VarChar(160)
  nivelPoder     Int          @map("nivel_poder") @db.SmallInt
  imagenUrl      String       @map("imagen_url")
  estado         EstadoHeroe
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  misiones       Mision[]

  @@map("heroes")
}

model Mision {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo       String       @db.VarChar(160)
  descripcion  String
  ubicacion    String       @db.VarChar(160)
  fecha        DateTime     @db.Date
  nivelPeligro NivelPeligro @map("nivel_peligro")
  estado       EstadoMision
  superheroeId String       @map("superheroe_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  superheroe   Heroe        @relation(fields: [superheroeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([superheroeId], map: "misiones_superheroe_id_idx")
  @@index([fecha], map: "misiones_fecha_idx")
  @@map("misiones")
}

model TokenRevocado {
  jti       String   @id @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  expiraEn  DateTime @map("expira_en") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([expiraEn], map: "tokens_revocados_expira_en_idx")
  @@map("tokens_revocados")
}
