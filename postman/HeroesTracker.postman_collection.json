      "item": [
        {
          "name": "Registrar usuario CONSULTA",
          "description": "Ejecutar manualmente con un email nuevo. La API no incluye eliminación de usuarios, por lo que no forma parte del flujo automatizado.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const response = pm.response.json();",
                  "pm.test(\"Siempre registra CONSULTA\", () => pm.expect(response.data.rol).to.eql(\"CONSULTA\"));",
                  "pm.test(\"No expone contraseña\", () => pm.expect(JSON.stringify(response)).not.to.include(\"password\"));"
                ]
              }
            }
          ],
          "request": {
