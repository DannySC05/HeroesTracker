    "name": "HeroesTracker API",
    "description": "Colección del Hito 5. Ejecutar la carpeta “Flujo automatizado” para probar autenticación, permisos, CRUD, errores y limpieza.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Flujo automatizado",
      "description": "Ejecutar esta carpeta con el Collection Runner. Requiere las credenciales de los usuarios ADMIN y CONSULTA sembrados.",
      "item": [
        {
          "name": "01 - Preparación y autenticación",
          "item": [
            {
              "name": "Health",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                      "const response = pm.response.json();",
                      "pm.test(\"Servicio saludable\", () => pm.expect(response.data.status).to.eql(\"ok\"));"
                    ]
                  }
                }
              ],
              "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/health" }
            },
            {
              "name": "Login ADMIN",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                      "const response = pm.response.json();",
                      "pm.test(\"Rol ADMIN\", () => pm.expect(response.data.usuario.rol).to.eql(\"ADMIN\"));",
                      "pm.test(\"JWT recibido\", () => pm.expect(response.data.token).to.be.a(\"string\").and.not.empty);",
                      "pm.environment.set(\"admin_token\", response.data.token);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": "{{base_url}}/api/auth/login"
              }
            },
            {
              "name": "Login CONSULTA",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                      "const response = pm.response.json();",
                      "pm.test(\"Rol CONSULTA\", () => pm.expect(response.data.usuario.rol).to.eql(\"CONSULTA\"));",
                      "pm.environment.set(\"consulta_token\", response.data.token);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{consulta_email}}\",\n  \"password\": \"{{consulta_password}}\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": "{{base_url}}/api/auth/login"
              }
            },
            {
              "name": "Me ADMIN",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                      "const response = pm.response.json();",
                      "pm.test(\"Usuario autenticado\", () => pm.expect(response.data.rol).to.eql(\"ADMIN\"));"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{admin_token}}", "type": "text" }
                ],
                "url": "{{base_url}}/api/auth/me"
              }
            }
          ]
        },
        {
