                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                      "const response = pm.response.json();",
                      "pm.test(\"Listado con total\", () => { pm.expect(response.data).to.be.an(\"array\"); pm.expect(response.meta.total).to.eql(response.data.length); });"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{consulta_token}}", "type": "text" }
                ],
                "url": "{{base_url}}/api/heroes"
              }
            },
            {
              "name": "Crear héroe como ADMIN",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const suffix = `${Date.now()}-${Math.random().toString(16).slice(2, 8)}`;",
                      "pm.collectionVariables.set(\"run_suffix\", suffix);",
                      "pm.collectionVariables.unset(\"hero_id\");",
                      "pm.collectionVariables.unset(\"mission_id\");"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                      "const response = pm.response.json();",
                      "pm.test(\"Héroe creado\", () => pm.expect(response.data.id).to.be.a(\"string\").and.not.empty);",
                      "pm.collectionVariables.set(\"hero_id\", response.data.id);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{admin_token}}", "type": "text" },
                  { "key": "Content-Type", "value": "application/json", "type": "text" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"Postman Hero {{run_suffix}}\",\n  \"nombre_real\": \"Identidad Temporal\",\n  \"poder_principal\": \"Pruebas automatizadas\",\n  \"nivel_poder\": 50,\n  \"imagen_url\": \"https://example.com/postman-hero.jpg\",\n  \"estado\": \"ACTIVO\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": "{{base_url}}/api/heroes"
              }
            },
            {
              "name": "Obtener héroe creado",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                      "const response = pm.response.json();",
                      "pm.test(\"UUID coincide\", () => pm.expect(response.data.id).to.eql(pm.collectionVariables.get(\"hero_id\")));"
                    ]
