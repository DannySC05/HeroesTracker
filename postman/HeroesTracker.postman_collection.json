                      "pm.test(\"Código de error RESOURCE_NOT_FOUND\", () => pm.expect(response.error.code).to.eql(\"RESOURCE_NOT_FOUND\"));",
                      "pm.collectionVariables.unset(\"hero_id\");",
                      "pm.collectionVariables.unset(\"run_suffix\");"
                    ]
