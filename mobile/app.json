{
  "expo": {
    "name": "Heroes Tracker",
    "slug": "heroes-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "heroes-tracker",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.heroestracker.app"
    },
    "android": {
